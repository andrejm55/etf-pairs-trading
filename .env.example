# Copy this file to .env for local paper-trading commands.
# Never commit any real credentials.
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_TRADING_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_PAPER=true
RUST_LOG=info,etf_pairs_engine=debug
